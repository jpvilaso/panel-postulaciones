# Copiar a .env y completar para activar llamadas reales a Claude.
# Sin esto, los 2 endpoints de IA (generar-anexos, auditar-documentos)
# funcionan igual, pero devuelven un resultado sintético claramente marcado
# como "modo demo" en vez de leer el documento de verdad.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

PORT=3300
SESSION_SECRET=cambiar-esto-en-produccion

# SSO hacia agente-concursos (Fase E, reemplaza su Basic Auth compartido).
# JWT_SECRET debe ser EXACTAMENTE el mismo valor que en el servicio de
# Railway de agente-concursos -- es lo único que conecta ambos servicios.
# AGENTE_CONCURSOS_URL es el origen permitido para "volver" tras el SSO
# (protege /sso/agente-concursos de usarse como open redirect).
JWT_SECRET=cambiar-esto-en-produccion-mismo-valor-en-ambos-servicios
AGENTE_CONCURSOS_URL=https://tablero-concursos.netlify.app